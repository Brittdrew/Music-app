# Vite environment variables (must be prefixed with VITE_ to be exposed to the browser)

# YouTube Data API v3 key - get one at https://console.cloud.google.com/
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# Google OAuth Client ID - get at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Backend API base URL (include /api suffix)
# Development: http://localhost:8000/api
# Production:  https://your-api-domain.com/api
VITE_API_URL=http://localhost:8000/api
